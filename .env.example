# Optional: URL of the stellar-txwatch-core API
# Leave empty to use localStorage-only mode
# Must include the http:// or https:// scheme; a trailing slash is stripped
# Examples:
#   Local development: http://localhost:8000
#   Staging: https://api-staging.example.com
#   Production: https://api.example.com
NEXT_PUBLIC_API_URL=

# Optional: Webhook testing endpoint
# Use this to test webhook delivery locally
# Example: http://localhost:3001/webhooks
# WEBHOOK_TEST_URL=

# Optional: Soroban RPC endpoint override
# Defaults to keyless public endpoint (https://mainnet.sorobanrpc.com) for mainnet
# and official endpoints for testnet/futurenet if not set.
# NEXT_PUBLIC_SOROBAN_RPC_URL_MAINNET=https://mainnet.sorobanrpc.com
# NEXT_PUBLIC_SOROBAN_RPC_URL=


# Optional: Horizon API endpoint override
# Defaults to official Stellar endpoints if not set
# Example: https://horizon-testnet.stellar.org
# NEXT_PUBLIC_HORIZON_URL=

# Optional: Per-network Horizon API endpoint overrides
# Defaults to official Stellar endpoints if not set.
# Overrides are validated at startup; invalid URLs are ignored (and logged in dev).
# Examples:
#   NEXT_PUBLIC_HORIZON_URL_MAINNET=https://horizon.stellar.org
#   NEXT_PUBLIC_HORIZON_URL_TESTNET=https://horizon-testnet.stellar.org
#   NEXT_PUBLIC_HORIZON_URL_FUTURENET=https://horizon-futurenet.stellar.org
# NEXT_PUBLIC_HORIZON_URL_MAINNET=
# NEXT_PUBLIC_HORIZON_URL_TESTNET=
# NEXT_PUBLIC_HORIZON_URL_FUTURENET=

# Optional: Per-network Soroban RPC endpoint overrides
# Defaults to official Stellar endpoints if not set.
# Overrides are validated at startup; invalid URLs are ignored (and logged in dev).
# Examples:
#   NEXT_PUBLIC_SOROBAN_RPC_URL_MAINNET=https://mainnet.stellar.validationcloud.io/v1/<key>
#   NEXT_PUBLIC_SOROBAN_RPC_URL_TESTNET=https://soroban-testnet.stellar.org
#   NEXT_PUBLIC_SOROBAN_RPC_URL_FUTURENET=https://rpc-futurenet.stellar.org
# NEXT_PUBLIC_SOROBAN_RPC_URL_MAINNET=
# NEXT_PUBLIC_SOROBAN_RPC_URL_TESTNET=
# NEXT_PUBLIC_SOROBAN_RPC_URL_FUTURENET=

# Optional: Sentry DSN for client-side error tracking
# Error tracking is enabled only when this is set.
# Example: https://<public-key>@o<org-id>.ingest.sentry.io/<project-id>
# NEXT_PUBLIC_SENTRY_DSN=

# Optional: Sentry auth token for source map uploads
# Only used in CI; source maps are uploaded only when this is present.
# Do NOT expose this to the client (no NEXT_PUBLIC_ prefix).
# SENTRY_AUTH_TOKEN=